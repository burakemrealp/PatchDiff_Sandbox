# --- APPLICATION & SERVER ---
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- DATABASE & CACHE SETTINGS ---
POSTGRES_USER=patchdiff
POSTGRES_PASSWORD=patchdiff_secret
POSTGRES_DB=patchdiff_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://patchdiff:patchdiff_secret@localhost:5432/patchdiff_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- UNIVERSAL OPENAI-COMPATIBLE LLM SETTINGS (groq | openai | deepseek | offline) ---
# Set LLM_PROVIDER=offline (or leave LLM_API_KEY empty) to run 100% deterministically without an API key.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=5.0

# --- RIOT DATA DRAGON & AUTOMATIC PATCH SYNC ---
DDRAGON_VERSION=16.23.1
DDRAGON_LANG=tr_TR
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=360

# --- FRONTEND (OPTIONAL) ---
# VITE_API_URL=http://127.0.0.1:8000/api/v1
